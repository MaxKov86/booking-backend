# Скопіюй цей файл у .env і заповни реальними значеннями. .env НЕ комітиться в git.

# MongoDB Atlas connection string:
# 1. Зареєструйся на https://www.mongodb.com/cloud/atlas (безкоштовний M0 tier)
# 2. Створи кластер, у "Database Access" додай користувача з паролем
# 3. У "Network Access" дозволь доступ з твого IP (або 0.0.0.0/0 для розробки)
# 4. "Connect" -> "Drivers" -> скопіюй connection string, встав пароль замість <password>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booking?retryWrites=true&w=majority

# Секрет для підпису JWT — будь-який довгий випадковий рядок (наприклад,
# `openssl rand -base64 32` в терміналі)
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Origin фронтенду для CORS — адреса, з якої Next.js dev-сервер робить запити
CORS_ORIGIN=http://localhost:3000
