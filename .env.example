# Скопіюй цей файл у .env і заповни реальними значеннями. .env НЕ комітиться в git.

# MongoDB Atlas connection string:
# 1. Зареєструйся на https://www.mongodb.com/cloud/atlas (безкоштовний M0 tier)
# 2. Створи кластер, у "Database Access" додай користувача з паролем
# 3. У "Network Access" дозволь доступ з твого IP (або 0.0.0.0/0 для розробки)
# 4. "Connect" -> "Drivers" -> скопіюй connection string, встав пароль замість <password>
#
# Якщо DNS не резолвить SRV-запис (querySrv ENOTFOUND) — вимкни тумблер
# "SRV Connection String" в Atlas і візьми звичайний mongodb:// формат.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booking?retryWrites=true&w=majority

# Секрет для підпису JWT — згенеруй командою:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

CORS_ORIGIN=http://localhost:3000

# SMTP для email-нотифікацій (ОПЦІЙНО — без цих змінних бронювання
# працюють нормально, просто листи не надсилаються, з попередженням у логах).
#
# Для розробки НЕ використовуй реальний Gmail/поштовий сервер — візьми
# фейковий SMTP, який ловить листи замість надсилання:
#   - https://ethereal.email — натисни "Create Ethereal Account", отримаєш
#     готові host/port/user/pass одразу на сторінці
#   - або https://mailtrap.io (потрібна реєстрація)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
